page {
  height: 100%;
  background: #fffaf2;
}

.webview-page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: #fffaf2;
}

.state-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: #fffaf2;
}

.state-card {
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 36rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 28rpx;
  box-sizing: border-box;
  color: #2f241b;
  background: #fff;
  text-align: center;
}

.state-title {
  font-size: 36rpx;
  font-weight: 700;
}

.state-description {
  margin-top: 18rpx;
  color: #806b59;
  font-size: 26rpx;
  line-height: 1.6;
}

.retry-button {
  margin: 32rpx auto 0;
  padding: 18rpx 30rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #7a421b;
  font-size: 28rpx;
}
