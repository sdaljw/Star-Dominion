<scroll-view class="page-scroll" scroll-y type="list">
  <view class="home-page">
    <view class="hero-card">
      <view class="eyebrow">逐梦工具箱 · 原生小程序版</view>
      <view class="hero-title">工具箱</view>
      <view class="hero-description">常用工具，打开即用，数据优先留在当前设备。</view>
      <search-bar value="{{query}}" bindchange="onSearchInput" />
    </view>

    <view class="section-heading">
      <text class="section-title">全部分类</text>
      <text class="section-count">{{categories.length}} 个分类</text>
    </view>
    <view class="category-grid">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-card"
        data-category="{{item.id}}"
        bindtap="openCategory"
      >
        <view class="category-card-top">
          <text class="category-name">{{item.name}}</text>
          <text class="category-count">{{item.count}} 个工具</text>
        </view>
        <text class="category-description">{{item.description}}</text>
        <text class="category-action">查看分类 ›</text>
      </view>
    </view>

    <view wx:if="{{query}}" class="section-heading section-heading-tools">
      <text class="section-title">搜索结果</text>
      <text class="section-count">{{searchResults.length}} 个工具</text>
    </view>
    <view wx:if="{{query}}" class="tool-grid">
      <tool-card
        wx:for="{{searchResults}}"
        wx:key="id"
        tool="{{item}}"
        bindtap="openTool"
      />
    </view>

    <view wx:if="{{query && searchResults.length === 0}}" class="search-hint">没有找到匹配工具，换个关键词试试。</view>
  </view>
</scroll-view>
