page {
  height: 100%;
}

.page-scroll {
  height: 100vh;
}

.home-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 64rpx;
}

.hero-card {
  padding: 34rpx 30rpx 30rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #fffdf9, #f9eedf);
  box-shadow: 0 18rpx 42rpx rgba(122, 66, 27, 0.08);
}

.eyebrow {
  color: #9a5a28;
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #2f241b;
  font-size: 56rpx;
  font-weight: 700;
}

.hero-description {
  margin-top: 10rpx;
  color: #806b59;
  font-size: 26rpx;
  line-height: 1.55;
}

.search-box {
  margin-top: 26rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 4rpx 16rpx;
}

.section-heading-tools {
  margin-top: 38rpx;
}

.section-title {
  color: #2f241b;
  font-size: 32rpx;
  font-weight: 700;
}

.section-count {
  color: #9b8775;
  font-size: 23rpx;
}

.category-scroller {
  width: 100%;
  white-space: nowrap;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-right: 14rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 999rpx;
  color: #66452d;
  background: #fffaf2;
  font-size: 24rpx;
}

.category-count {
  color: #ad8d70;
  font-size: 20rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.search-hint {
  margin-top: 26rpx;
  color: #9b8775;
  font-size: 23rpx;
  text-align: center;
}
