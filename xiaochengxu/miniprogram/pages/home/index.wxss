page {
  height: 100%;
}

.page-scroll {
  height: 100vh;
}

.home-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 64rpx;
}

.hero-card {
  padding: 34rpx 30rpx 30rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #fffdf9, #f9eedf);
  box-shadow: 0 18rpx 42rpx rgba(122, 66, 27, 0.08);
}

.eyebrow {
  color: #9a5a28;
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #2f241b;
  font-size: 56rpx;
  font-weight: 700;
}

.hero-description {
  margin-top: 10rpx;
  color: #806b59;
  font-size: 26rpx;
  line-height: 1.55;
}

.search-box {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e2cdb4;
  border-radius: 18rpx;
  background: #fff;
}

.search-icon {
  margin-right: 14rpx;
  color: #9a5a28;
  font-size: 40rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  height: 82rpx;
  color: #2f241b;
  font-size: 27rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 4rpx 16rpx;
}

.section-heading-tools {
  margin-top: 38rpx;
}

.section-title {
  color: #2f241b;
  font-size: 32rpx;
  font-weight: 700;
}

.section-count {
  color: #9b8775;
  font-size: 23rpx;
}

.category-scroller {
  width: 100%;
  white-space: nowrap;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-right: 14rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 999rpx;
  color: #66452d;
  background: #fffaf2;
  font-size: 24rpx;
}

.category-count {
  color: #ad8d70;
  font-size: 20rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.tool-card {
  min-width: 0;
  padding: 22rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(122, 66, 27, 0.06);
}

.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  color: #fff;
  background: linear-gradient(135deg, #5f6f42, #9a5a28);
  font-size: 32rpx;
}

.tool-name {
  display: block;
  margin-top: 18rpx;
  overflow: hidden;
  color: #2f241b;
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-description {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #806b59;
  font-size: 22rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.search-hint {
  margin-top: 26rpx;
  color: #9b8775;
  font-size: 23rpx;
  text-align: center;
}
